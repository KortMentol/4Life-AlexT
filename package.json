{
  "name": "alexander-toshchev-4life",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "lint:fix": "eslint . --ext ts,tsx,js,jsx --report-unused-disable-directives --fix",
    "lint:watch": "esw --ext .js,.jsx,.ts,.tsx --format=codeframe --watch src",
    "preview": "vite preview",
    "preview:local": "vite preview --host 192.168.0.11 --port 4173",
    "dev:local": "vite --host 192.168.0.11 --port 3000",
    "clean": "rmdir /s /q node_modules .vite 2>nul & npm install",
    "clean:cache": "rmdir /s /q .vite 2>nul",
    "clean:modules": "rmdir /s /q node_modules 2>nul & npm install",
    "fresh": "npm run clean & npm run dev",
    "reset": "npm run clean & npm run build"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/syne": "^5.2.7",
    "@headlessui/react": "^1.7.18",
    "framer-motion": "^11.18.2",
    "gsap": "^3.13.0",
    "lenis": "^1.3.8",
    "lucide-react": "^0.344.0",
    "ogl": "^1.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.23.0",
    "swiper": "^12.1.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/react-helmet-async": "^1.0.1",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-formatter-codeframe": "^7.32.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.7",
    "eslint-watch": "^8.0.0",
    "postcss": "^8.4.35",
    "postcss-preset-env": "^10.2.3",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.4.1",
    "terser": "^5.42.0",
    "typescript": "^6.0.3",
    "vite": "^6.3.5"
  }
}
