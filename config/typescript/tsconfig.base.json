{
  /**
   * @description Этот файл содержит базовые настройки компилятора TypeScript для всего проекта.
   * Другие файлы tsconfig.json в проекте (например, для Vite или Vitest) наследуют эти опции,
   * чтобы обеспечить консистентность правил компиляции и статического анализа.
   */
  "compilerOptions": {
    /* ================================================================================================== */
    /* =============================== БАЗОВАЯ НАСТРОЙКА (СБОРКА И МОДУЛИ) =============================== */
    /* ================================================================================================== */

    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    /* ================================================================================================== */
    /* =================================== ИНТЕГРАЦИЯ СО СРЕДОЙ =================================== */
    /* ================================================================================================== */

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,

    /* ================================================================================================== */
    /* =================================== СТРОГОСТЬ И БЕЗОПАСНОСТЬ =================================== */
    /* ================================================================================================== */

    "strict": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,

    /* ================================================================================================== */
    /* ========================================= КАЧЕСТВО КОДА ========================================= */
    /* ================================================================================================== */

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "moduleDetection": "force"
  }
}
