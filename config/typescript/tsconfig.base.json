{
  /**
   * @description Этот файл содержит базовые настройки компилятора TypeScript для всего проекта.
   * Другие файлы tsconfig.json в проекте (например, для Vite или Vitest) наследуют эти опции,
   * чтобы обеспечить консистентность правил компиляции и статического анализа.
   */
  "compilerOptions": {
        // Определяет версию JavaScript, в которую будет скомпилирован TypeScript. ES2020 поддерживает современные возможности, такие как BigInt и globalThis.
    "target": "ES2020",
        // Использует стандартный синтаксис полей классов ECMAScript вместо старого поведения TypeScript. Обеспечивает лучшую совместимость со стандартами.
    "useDefineForClassFields": true,
        // Указывает систему модулей. ESNext — это последняя версия модулей ECMAScript, что позволяет использовать динамические импорты и другие современные возможности.
    "module": "ESNext",
        // Пропускает проверку типов для всех файлов деклараций (*.d.ts), что ускоряет компиляцию, особенно в проектах с большим количеством зависимостей.
    "skipLibCheck": true,
        // Улучшает совместимость между модулями CommonJS (старый стиль Node.js) и ES-модулями, позволяя использовать `import React from 'react'` вместо `import * as React from 'react'`.
    "esModuleInterop": true,
        // Разрешает "синтетические" импорты по умолчанию. Это дополнение к `esModuleInterop`, которое делает импорты более удобными.
    "allowSyntheticDefaultImports": true,
        // Запрещает импортировать один и тот же файл с разным регистром символов в имени (например, `import './file'` и `import './File'`). Помогает избежать проблем на системах, чувствительных к регистру.
    "forceConsistentCasingInFileNames": true,
        // Указывает, как TypeScript должен разрешать модули. 'bundler' — это современный режим, оптимизированный для работы с бандлерами вроде Vite, Webpack или Rollup.
    "moduleResolution": "bundler",
        // Разрешает импортировать файлы TypeScript с их расширениями (например, `import './file.ts'`). Требуется для некоторых современных конфигураций.
    "allowImportingTsExtensions": true,
        // Гарантирует, что каждый файл может быть скомпилирован отдельно, без зависимости от других файлов. Это требование для некоторых сборщиков (например, Babel).
    "isolatedModules": true,
        // Гарантирует, что каждый файл рассматривается как модуль, даже если в нем нет `import` или `export`. Это предотвращает случайное объявление переменных в глобальной области видимости.
    "moduleDetection": "force",
        // Указывает компилятору не создавать выходные JavaScript-файлы. Это типично для проектов, где компиляцией занимается другой инструмент (например, Vite или Babel), а TypeScript используется только для проверки типов.
    "noEmit": true,
        // Настраивает обработку JSX. 'react-jsx' — это современный рантайм, который автоматически импортирует React, избавляя от необходимости писать `import React from 'react'` в каждом файле с JSX.
    "jsx": "react-jsx",
        // Включает все строгие проверки типов (`strictNullChecks`, `strictFunctionTypes` и т.д.). Это "золотой стандарт" для надежного кода на TypeScript.
    "strict": true,
        // Сообщает об ошибке, если в коде есть неиспользуемые локальные переменные. Помогает поддерживать чистоту кода.
    "noUnusedLocals": true,
        // Сообщает об ошибке, если в функции есть неиспользуемые параметры. Также способствует чистоте кода.
    "noUnusedParameters": true,
        // Запрещает "проваливание" из одного `case` в другой в `switch`-конструкциях без `break` или `return`. Помогает избежать случайных ошибок.
    "noFallthroughCasesInSwitch": true,
        // Запрещает неявный тип `any`. Если тип переменной не может быть выведен, его нужно указать явно. Это одна из ключевых опций `strict`.
    "noImplicitAny": true,
        // Запрещает использовать `this` с неявным типом `any`. Требует явного указания контекста `this`.
    "noImplicitThis": true,
        // Включает строгую проверку на `null` и `undefined`. Переменные не могут быть `null` или `undefined`, если это не указано явно (например, `string | null`). Критически важная опция для предотвращения ошибок времени выполнения.
    "strictNullChecks": true,
        // Включает строгую проверку типов параметров функций, что делает код более надежным при работе с функциями обратного вызова.
    "strictFunctionTypes": true,
        // Требует, чтобы все свойства класса были инициализированы в конструкторе или при объявлении.
    "strictPropertyInitialization": true,
        // Гарантирует, что все ветви функции возвращают значение, если функция должна что-то возвращать.
    "noImplicitReturns": true,
        // Добавляет `| undefined` к типам при доступе к элементам массива или объекта по индексу/ключу. Заставляет проверять, что элемент действительно существует, прежде чем его использовать.
    "noUncheckedIndexedAccess": true
  }
}
